# =============================================================
#  IOGT Uzbekistan – PRODUCTION environment variables
#  Place at:  /opt/iogt/iogt-main/.env.prod
#
#  IMPORTANT:
#   - Change SECRET_KEY to a long random string (instructions in guide)
#   - Change DB_PASSWORD to a strong password
#   - Set CSRF_TRUSTED_ORIGINS to your real domain
# =============================================================

# --- Tell Django to use production settings ---
DJANGO_SETTINGS_MODULE=iogt.settings.production

# --- Debug OFF in production (do NOT set to 'enable') ---
DEBUG=disable

# --- Security: generate your own! (see guide, step 7) ---
SECRET_KEY=CHANGE-ME-to-a-long-random-50-character-string

# --- Database (internal Postgres container) ---
DB_NAME=iogt
DB_USER=postgres
DB_PASSWORD=CHANGE-ME-to-a-strong-password
DB_HOST=db
DB_PORT=5432
# The internal container DB does NOT use SSL, so disable it:
DB_SSL_MODE=disable

# --- Your domain(s) – must include http/https scheme ---
CSRF_TRUSTED_ORIGINS=https://iogt.bslab.uz

# --- Feature flags ---
JQUERY=enable
PUSH_NOTIFICATION=disable
CACHE=
MATOMO_TRACKING=disable
COMMENTS_COMMUNITY_MODERATION=disable
IMAGE_SIZE_PRESET=360
LOG_LEVEL=INFO

# --- Leave blank unless used ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_ADMIN_EMAIL=
WAGTAILTRANSFER_SECRET_KEY=
SUPERSET_BASE_URL=
SUPERSET_DATABASE_NAME=
SUPERSET_USERNAME=
SUPERSET_PASSWORD=
